{
  "name": "page-accent",
  "private": true,
  "version": "0.1.3",
  "description": "A Manifest V3 browser extension that adds local color accents to matching websites.",
  "license": "MIT",
  "author": "baozheliu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baozheliu/page-accent.git"
  },
  "bugs": {
    "url": "https://github.com/baozheliu/page-accent/issues"
  },
  "homepage": "https://github.com/baozheliu/page-accent#readme",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "edge-extension",
    "firefox-extension",
    "manifest-v3",
    "tab-management",
    "vue",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:chrome": "EXTENSION_TARGET=chrome vite build",
    "build:edge": "EXTENSION_TARGET=edge vite build",
    "build:firefox": "EXTENSION_TARGET=firefox vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e-*.test.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "check": "npm run validate:manifest && npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.4.5"
  }
}
